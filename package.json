{
  "name": "psdte",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @psdte/api db:migrate",
    "db:seed": "pnpm --filter @psdte/api db:seed",
    "db:reset": "pnpm --filter @psdte/api db:reset",
    "verificar": "node packages/xml-engine/dist/cli/verificar.js"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.0",
      "js-yaml": "^4.3.0",
      "postcss": "^8.5.12",
      "qs": "^6.15.2",
      "uuid": "^11.1.1",
      "file-type": "^21.3.2",
      "adm-zip": "^0.6.0",
      "glob@>=11.0.0 <11.1.0": "^11.1.0",
      "multer": "^2.2.0",
      "body-parser": "^1.20.6"
    }
  }
}
