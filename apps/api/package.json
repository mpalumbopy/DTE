{
  "name": "@psdte/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:e2e": "jest --config jest.e2e.config.js --passWithNoTests",
    "db:migrate": "node-pg-migrate up -m db/migrations -d DATABASE_URL --envPath .env",
    "db:migrate:down": "node-pg-migrate down -m db/migrations -d DATABASE_URL --envPath .env",
    "db:seed": "ts-node -r tsconfig-paths/register src/../../../db/seeds/run-seeds.ts",
    "db:reset": "pnpm db:migrate:down 0 || true && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@psdte/shared": "workspace:*",
    "@psdte/xml-engine": "workspace:*",
    "@psdte/crypto-providers": "workspace:*",
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.9.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
