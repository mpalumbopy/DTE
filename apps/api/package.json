{
  "name": "@psdte/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:e2e": "NODE_ENV=test jest --config jest.e2e.config.js --passWithNoTests",
    "db:migrate": "node-pg-migrate up -m ../../db/migrations -d DATABASE_URL --envPath ../../.env",
    "db:migrate:down": "node-pg-migrate down -m ../../db/migrations -d DATABASE_URL --envPath ../../.env",
    "db:seed": "pnpm --filter @psdte/db-seeds run seed",
    "db:reset": "pnpm db:migrate:down 999 || true && pnpm db:migrate && pnpm db:seed",
    "db:migrate:test": "node-pg-migrate up -m ../../db/migrations -d DATABASE_URL --envPath ../../.env.test",
    "db:migrate:down:test": "node-pg-migrate down -m ../../db/migrations -d DATABASE_URL --envPath ../../.env.test",
    "db:seed:test": "pnpm --filter @psdte/db-seeds run seed:test",
    "db:reset:test": "pnpm db:migrate:down:test 999 || true && pnpm db:migrate:test && pnpm db:seed:test"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^10.0.2",
    "@psdte/crypto-providers": "workspace:*",
    "@psdte/shared": "workspace:*",
    "@psdte/xml-engine": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^5.81.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "node-pg-migrate": "^7.9.1",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "puppeteer-core": "^23.9.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "maildev": "^2.2.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
