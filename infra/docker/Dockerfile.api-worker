# syntax=docker/dockerfile:1
#
# Mismo build que Dockerfile.api (mismo dist, mismo código) — solo cambia el runtime: PROCESS_ROLE
# fijo en 'worker', y CMD apunta a dist/main.worker.js (createApplicationContext, sin HTTP; ver
# apps/api/src/worker.module.ts). Incluye chromium+ghostscript aunque el worker no dispara todavía
# el job de exportaciones on-demand (ese sigue síncrono en el proceso api, ver docs/ESTADO.md F13
# "Pendiente"): JobsModule importa ExportacionModule completo (para ReselladoService/
# ReconciliacionService), y Nest instancia todos sus providers al cargar el módulo — incluido
# ExportacionService, que referencia CHROMIUM_PATH/GHOSTSCRIPT_PATH en su constructor aunque no los
# invoque hasta que se genera un PDF. Sin los binarios el proceso igual arranca (no se tocan en el
# constructor), pero el plan (sección 11) pide explícitamente la imagen del worker con
# chromium+ghostscript — se respeta tal cual para no dejar la imagen coja el día que el job de
# exportaciones se mueva acá.
FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/xml-engine/package.json packages/xml-engine/package.json
COPY packages/crypto-providers/package.json packages/crypto-providers/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter @psdte/shared --filter @psdte/xml-engine --filter @psdte/crypto-providers --filter @psdte/api build

FROM base AS runtime
ENV NODE_ENV=production
ENV PROCESS_ROLE=worker
RUN apk add --no-cache chromium ghostscript ttf-freefont
RUN addgroup -S psdte && adduser -S psdte -G psdte
WORKDIR /app
COPY --from=build /repo/apps/api/dist ./dist
COPY --from=build /repo/apps/api/node_modules ./node_modules
COPY --from=build /repo/apps/api/package.json ./package.json
COPY --from=build /repo/packages/shared/dist ./node_modules/@psdte/shared/dist
COPY --from=build /repo/packages/xml-engine/dist ./node_modules/@psdte/xml-engine/dist
COPY --from=build /repo/packages/crypto-providers/dist ./node_modules/@psdte/crypto-providers/dist
USER psdte
CMD ["node", "dist/main.worker.js"]
